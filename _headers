# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Format:  a path pattern on its own line, followed by indented "Header: value" lines.

# Keep preview deployments out of Google's index.
# Cloudflare Pages serves every build at <hash>.<project>.pages.dev; this rule
# tags ONLY those preview hosts with noindex. Your production custom domain
# (tangdetailing.com) is NOT a *.pages.dev host, so it is unaffected and stays
# fully indexable. Verify after deploy: production response should NOT carry
# this header (curl -sI https://tangdetailing.com | grep -i x-robots-tag → empty).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Long-cache immutable static assets (safe: filenames change when content does,
# and photos here are versioned by path).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers.
# HSTS: 1 year, all subdomains. Deliberately NOT "preload" — preload entries are
# baked into browser binaries and take months to undo, so it is not worth the
# risk for a marketing site.
# Framing: SAMEORIGIN (not DENY) blocks third-party clickjacking while leaving
# room to embed our own pages. The site frames Google Maps and the Revvedpro
# form, which these headers do not affect — they only govern framing OF us.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
